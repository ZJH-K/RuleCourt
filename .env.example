# 复制为 .env 并填写密钥。绝不要提交 .env。
# 文本生成（DeepSeek；使用现有 OpenAI 兼容 provider adapter）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
RULECOURT_MODEL=deepseek-flash

# Embedding 与 reranking（阿里云百炼 Model Studio）。
# T13 CLI 使用这些配置调用 Qwen embedding 和原生 reranking。
# 从百炼控制台复制 API Host（例如 llm-xxx.cn-beijing.maas.aliyuncs.com）。
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank

# 本地维护和正式 Golden Case 签核配置（不是 provider API key）。
RULECOURT_MAINTENANCE_TOKEN=
RULECOURT_GOLDEN_SIGNOFF_KEY=
